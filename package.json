{
  "name": "iptv-source-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write src scripts test package.json tsconfig.json wrangler.jsonc",
    "format:check": "prettier --check src scripts test package.json tsconfig.json wrangler.jsonc",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler dev --port 8787",
    "check": "node scripts/build.mjs && tsc --noEmit",
    "test": "node scripts/build.mjs && tsx --test test/*.test.ts",
    "deploy": "node scripts/deploy.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:check": "node scripts/build.mjs && wrangler deploy --dry-run",
    "init:admin": "node scripts/init-admin.mjs",
    "db:init:local": "wrangler d1 execute DB --local --file private/bootstrap.sql",
    "db:init:remote": "wrangler d1 execute DB --remote --file private/bootstrap.sql"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "自动建表并在空库创建 admin / admin123，首次登录必须修改密码。已有账号不会重置；不内置任何直播源。"
      },
      "SESSION_SECRET": {
        "description": "必填：填写你自己生成并私下保存的至少 32 字符随机字符串，作为登录会话密钥，不含引号。可使用密码管理器生成，无需运行本机命令。不要填写管理员密码。"
      }
    }
  },
  "dependencies": {
    "hono": "^4.10.0",
    "ipaddr.js": "^2.2.0",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^24.0.0",
    "@types/nunjucks": "^3.2.6",
    "esbuild": "^0.25.0",
    "jsonc-parser": "^3.3.1",
    "miniflare": "5.20261019.0-beta",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "description": "Source-free IPTV channel manager for Cloudflare Workers and D1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liumw/iptv-source-cloudflare.git"
  },
  "homepage": "https://github.com/liumw/iptv-source-cloudflare#readme",
  "bugs": {
    "url": "https://github.com/liumw/iptv-source-cloudflare/issues"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  }
}
